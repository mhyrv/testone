{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "testone",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c3d90f1d-0f17-4923-b9dd-454c526eea04","database_name": "testone" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1aabe2380c7045c69daad7eeb49bfdd6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
